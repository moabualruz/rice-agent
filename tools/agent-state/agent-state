#!/usr/bin/env bash
# agent-state launcher: uses a packaged platform binary when present, otherwise builds from source.
# Scaffolded by rice-agent new; Bash 3.2 compatible.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;
    *) src="$dir/$src" ;;
  esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"

system="$(uname -s 2>/dev/null || true)"
machine="$(uname -m 2>/dev/null || true)"
case "$system" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) os="" ;;
esac
case "$machine" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) arch="" ;;
esac
if [ -n "$os" ] && [ -n "$arch" ] && [ -x "$here/bin/$os-$arch/agent-state" ]; then
  exec "$here/bin/$os-$arch/agent-state" "$@"
fi
if command -v go >/dev/null 2>&1; then
  out="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/agent-dry/go-bin/agent-state"
  mkdir -p "$(dirname "$out")"
  if ! GOFLAGS='' go -C "$here" build -o "$out.$$" . >&2; then
    rm -f "$out.$$"
    printf '%s: go build failed\n' "agent-state" >&2
    exit 3
  fi
  mv -f "$out.$$" "$out"
  exec "$out" "$@"
fi
printf '%s: needs go to build from source, or a prebuilt %s\n' "agent-state" "$here/bin/$os-$arch/agent-state" >&2
exit 3
