{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/moabualruz/agent-dry/schemas/tool/v1/tool.schema.json",
  "title": "Rice Agent tool manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "summary", "intents", "kind", "scope", "entry", "language", "side_effects", "exit_codes", "platforms", "test", "status", "origin"],
  "properties": {
    "schema": { "const": "tool/v1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 40 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 80, "pattern": "^Use when " },
    "intents": {
      "type": "array", "minItems": 3, "maxItems": 12, "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 60 }
    },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "kind": { "enum": ["script", "cli", "skill"] },
    "scope": { "enum": ["global", "project"] },
    "entry": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
    "language": { "enum": ["bash", "go", "typescript", "markdown"] },
    "side_effects": { "enum": ["read", "write-local", "remote-read", "remote-write", "destructive"] },
    "dry_run": { "type": "string", "pattern": "^--[a-z][a-z0-9-]*$" },
    "exit_codes": {
      "type": "object", "minProperties": 2,
      "propertyNames": { "pattern": "^[0-9]{1,3}$" },
      "additionalProperties": { "type": "string", "minLength": 2 }
    },
    "platforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["darwin-arm64", "darwin-amd64", "linux-amd64", "linux-arm64"] }
    },
    "requires": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9._+-]+( >= [0-9][0-9.]*)?$" }
    },
    "config": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$" } },
    "test": { "type": "string", "minLength": 3 },
    "replaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "status": { "enum": ["trial", "active", "deprecated", "retired"] },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": "string" },
    "extends": { "type": "string" },
    "distinct_from": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["tool", "reason"],
        "properties": { "tool": { "type": "string" }, "reason": { "type": "string", "minLength": 10 } }
      }
    },
    "origin": {
      "type": "object", "additionalProperties": false, "required": ["date", "builder", "task"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "builder": { "type": "string", "minLength": 2 },
        "task": { "type": "string", "minLength": 3 },
        "promoted_from": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "side_effects": { "enum": ["write-local", "remote-write", "destructive"] } }, "required": ["side_effects"] },
      "then": { "required": ["dry_run"] }
    },
    {
      "if": { "properties": { "status": { "const": "retired" } }, "required": ["status"] },
      "then": { "required": ["superseded_by"] }
    }
  ]
}
