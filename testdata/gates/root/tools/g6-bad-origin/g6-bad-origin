#!/usr/bin/env bash
# g6-bad-origin: gate fixture.
set -euo pipefail
case "${1:-}" in
  -h | --help)
    printf '%s\n' "Usage: g6-bad-origin <word>" "" "Exit codes: 0 success, 2 usage error."
    exit 0
    ;;
  '')
    printf '%s: missing word\n' "g6-bad-origin" >&2
    exit 2
    ;;
esac
printf '%s\n' "$1"
