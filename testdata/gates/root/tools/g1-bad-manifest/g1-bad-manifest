#!/usr/bin/env bash
# g1-bad-manifest: gate fixture.
set -euo pipefail
case "${1:-}" in
  -h | --help)
    printf '%s\n' "Usage: g1-bad-manifest <word>" "" "Exit codes: 0 success, 2 usage error."
    exit 0
    ;;
  '')
    printf '%s: missing word\n' "g1-bad-manifest" >&2
    exit 2
    ;;
esac
printf '%s\n' "$1"
