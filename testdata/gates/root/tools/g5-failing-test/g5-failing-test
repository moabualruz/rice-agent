#!/usr/bin/env bash
# g5-failing-test: gate fixture.
set -euo pipefail
case "${1:-}" in
  -h | --help)
    printf '%s\n' "Usage: g5-failing-test <word>" "" "Exit codes: 0 success, 2 usage error."
    exit 0
    ;;
  '')
    printf '%s: missing word\n' "g5-failing-test" >&2
    exit 2
    ;;
esac
printf '%s\n' "$1"
