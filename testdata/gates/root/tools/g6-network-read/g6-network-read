#!/usr/bin/env bash
# g6-network-read: gate fixture.
set -euo pipefail
case "${1:-}" in
  -h | --help)
    printf '%s\n' "Usage: g6-network-read <word>" "" "Exit codes: 0 success, 2 usage error."
    exit 0
    ;;
  '')
    printf '%s: missing word\n' "g6-network-read" >&2
    exit 2
    ;;
esac
case "$1" in
  http://* | https://*) curl -fsS --max-time 10 "$1" | head -n 20 ;;
  *) printf '%s\n' "$1" ;;
esac
