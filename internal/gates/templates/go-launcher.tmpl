#!/usr/bin/env bash
# {{.Name}} launcher: builds the Go source next to this file and runs it with the caller's
# working directory and arguments. Without Go, it runs a prebuilt bin/{{.Name}} beside this file.
# Scaffolded by agent-dry new; Bash 3.2 compatible.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;
    *) src="$dir/$src" ;;
  esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"

if command -v go >/dev/null 2>&1; then
  out="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/agent-dry/go-bin/{{.Name}}"
  mkdir -p "$(dirname "$out")"
  if ! GOFLAGS='' go -C "$here" build -o "$out.$$" . >&2; then
    rm -f "$out.$$"
    printf '%s: go build failed\n' "{{.Name}}" >&2
    exit 3
  fi
  mv -f "$out.$$" "$out"
  exec "$out" "$@"
fi
if [ -x "$here/bin/{{.Name}}" ]; then
  exec "$here/bin/{{.Name}}" "$@"
fi
printf '%s: needs go to build from source, or a prebuilt %s\n' "{{.Name}}" "$here/bin/{{.Name}}" >&2
exit 3
